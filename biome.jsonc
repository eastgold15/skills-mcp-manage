{
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "linter": {
    "rules": {
      "suspicious": {
        "useAwait": "off"
      },
      "performance": {
        "useTopLevelRegex": "off"
      }
    }
  }
}
